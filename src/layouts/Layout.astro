---
import '../styles/styles.css';
import '../styles/animations.css';
import { COMPANY_WHATSAPP, COMPANY_EMAIL } from '../data/constants';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
}

const { title, description = 'NexoIT — Soluciones que conectan. Desarrollo web, apps, sistemas y automatización.', canonical, ogType = 'website' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="es" style="scroll-behavior:smooth" id="top">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="NexoIT" />
<meta name="robots" content="index,follow" />
{canonical && <link rel="canonical" href={canonical} />}
<link rel="alternate" hreflang="es" href={canonical || 'https://nexoit-site.pages.dev/'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content="NexoIT" />
<meta property="og:locale" content="es_PE" />
<meta property="og:image" content="/assets/img/logo.jpg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content="https://nexoit-site.pages.dev/assets/img/logo.jpg" />
<script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebSite","name":"NexoIT","alternateName":"NexoIT - Soluciones que conectan","url":"https://nexoit-site.pages.dev/"})} />
<link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg" />
<link rel="icon" type="image/jpeg" href="/assets/img/logo.jpg" />
<meta name="theme-color" content="#0A0C10" />
<meta name="color-scheme" content="dark" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://cdn.jsdelivr.net" />
<link rel="preconnect" href="https://images.unsplash.com" />
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" /></noscript>
</head>
<body>
<a class="skip" href="#contenido">Saltar al contenido</a>

<slot />
<footer class="footer">
  <div class="container footer__grid">
    <div>
      <div class="brand brand--footer">
        <img class="brand__logo" src="/assets/img/logo.jpg" alt="Logo de NexoIT" width="36" height="36" loading="eager" />
        <div class="brand__text">
          <span class="brand__name">NexoIT</span>
          <span class="brand__tag">Soluciones que conectan</span>
        </div>
      </div>
      <p class="muted" style="margin-top:16px;max-width:320px">Desarrollo de páginas web, apps y software a medida. Automatizamos procesos para que tu negocio crezca.</p>
    </div>
    <div class="footer__col">
      <h4>Secciones</h4>
      <a href="/#servicios">Servicios</a>
      <a href="/#proceso">Proceso</a>
      <a href="/#portafolio">Portafolio</a>
      <a href="/#testimonios">Testimonios</a>
      <a href="/#planes">Planes</a>
      <a href="/#faq">FAQ</a>
      <a href="/#contacto">Contacto</a>
      <a href="/casos-exito">Casos de Éxito</a>
    </div>
    <div class="footer__col">
      <h4>Legal</h4>
      <a href="/terminos">Términos y condiciones</a>
      <a href="/privacidad">Política de privacidad</a>
    </div>
    <div class="footer__col">
      <h4>Contacto</h4>
      <a href="/#contacto">Cotizar</a>
      <a href={`mailto:${COMPANY_EMAIL}`}>{COMPANY_EMAIL}</a>
      <a href={`https://wa.me/${COMPANY_WHATSAPP}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
    <div class="footer__bottom" style="grid-column:1/-1">
      <span>&copy; {year} NexoIT. Todos los derechos reservados.</span>
      <span class="muted">Hecho por Piero & Eri</span>
    </div>
  </div>
</footer>

<button class="wa-float" id="waFloat" aria-label="Escríbenos por WhatsApp">
  <svg viewBox="0 0 24 24" width="28" height="28"><path fill="#fff" d="M17.472 14.382c-.293-.15-1.7-.84-1.96-.94-.26-.1-.45-.15-.64.15-.19.29-.74.94-.91 1.13-.17.19-.34.21-.63.07-.293-.15-1.22-.45-2.33-1.43-.86-.77-1.44-1.71-1.61-2-.17-.29-.02-.45.13-.59.13-.13.29-.34.44-.51.15-.17.19-.29.29-.48.1-.19.05-.37-.03-.51-.08-.15-.64-1.54-.88-2.11-.23-.56-.47-.48-.64-.49h-.55c-.19 0-.5.07-.76.37-.26.29-1 1-1 2.43s1.03 2.82 1.17 3.01c.15.19 2.03 3.1 4.93 4.35.69.3 1.23.48 1.65.61.69.22 1.32.19 1.82.11.55-.08 1.7-.7 1.94-1.37.24-.67.24-1.25.17-1.37-.08-.12-.26-.19-.55-.34zM12.05 21.7c-1.73 0-3.43-.46-4.92-1.33l-.35-.21-3.67.96.98-3.57-.23-.37a9.74 9.74 0 0 1-1.49-5.23c0-5.38 4.39-9.76 9.77-9.76 2.61 0 5.07 1.02 6.91 2.87a9.72 9.72 0 0 1 2.86 6.91c-.01 5.39-4.39 9.77-9.77 9.77z"/></svg>
</button>

<div class="wa-modal" id="waModal">
  <div class="wa-modal__box">
    <button class="wa-modal__close" id="waModalClose">&times;</button>
    <h3>Cotizar por WhatsApp</h3>
    <p class="wa-modal__sub">Déjanos tus datos y te atenderemos al instante.</p>
    <form id="waForm">
      <label>
        Nombre completo *
        <input type="text" id="waName" required placeholder="Tu nombre completo" autocomplete="name" />
</label>
  <input type="hidden" id="waPlan" name="waPlan" />
  <input type="hidden" id="waPrice" name="waPrice" />
  <input type="hidden" id="waDesc" name="waDesc" />
  <button type="submit" class="wa-modal__btn">
        <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M17.472 14.382c-.293-.15-1.7-.84-1.96-.94-.26-.1-.45-.15-.64.15-.19.29-.74.94-.91 1.13-.17.19-.34.21-.63.07-.293-.15-1.22-.45-2.33-1.43-.86-.77-1.44-1.71-1.61-2-.17-.29-.02-.45.13-.59.13-.13.29-.34.44-.51.15-.17.19-.29.29-.48.1-.19.05-.37-.03-.51-.08-.15-.64-1.54-.88-2.11-.23-.56-.47-.48-.64-.49h-.55c-.19 0-.5.07-.76.37-.26.29-1 1-1 2.43s1.03 2.82 1.17 3.01c.15.19 2.03 3.1 4.93 4.35.69.3 1.23.48 1.65.61.69.22 1.32.19 1.82.11.55-.08 1.7-.7 1.94-1.37.24-.67.24-1.25.17-1.37-.08-.12-.26-.19-.55-.34z"/></svg>
        Abrir WhatsApp
      </button>
    </form>
  </div>
</div>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Vista ampliada de imagen">
  <button class="lightbox__close" id="lightboxClose" aria-label="Cerrar">&times;</button>
  <button class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" aria-label="Imagen anterior">‹</button>
  <img id="lightboxImg" src="" alt="" />
  <button class="lightbox__nav lightbox__nav--next" id="lightboxNext" aria-label="Imagen siguiente">›</button>
</div>

<script src="/js/main.js" defer></script>
</body>
</html>
