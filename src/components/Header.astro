---
import { NAV_LINKS } from '../data/constants';
---

<nav class="navbar">
  <div class="navbar__container">
    <a href="/" class="navbar__brand" aria-label="Ir al inicio">
        <img src="/assets/img/logo.jpg" class="navbar__logo" alt="Logo NexoIT" />
        <span class="navbar__name">NexoIT</span>
    </a>
    
    <div class="navbar__nav">
      <ul class="navbar__list">
        {NAV_LINKS.map(link => (
          <li class="navbar__item">
            <a href={link.href} class="navbar__link">{link.label}</a>
          </li>
        ))}
        <li class="navbar__item navbar__item--dropdown">
          <button class="navbar__link navbar__link--dropdown" type="button">
            <span>Más</span>
            <svg class="navbar__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <div class="navbar__dropdown">
            <a href="/#equipo" class="navbar__dropdown-link">Equipo</a>
            <a href="/#tecnologias" class="navbar__dropdown-link">Tecnologías</a>
            <a href="/casos-exito" class="navbar__dropdown-link">Casos de Éxito</a>
            <a href="/#contacto" class="navbar__dropdown-link">Contacto</a>
          </div>
        </li>
      </ul>
    </div>

    <div class="navbar__actions">
        <a href="/#contacto" class="navbar__cta">Cotizar</a>
        <button class="navbar__toggle" type="button" aria-controls="navbar-menu" aria-expanded="false" id="navbar-toggle" aria-label="Abrir menú">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" d="M5 7h14M5 12h14M5 17h14"/>
            </svg>
        </button>
    </div>

    <div class="navbar__mobile" id="navbar-menu">
      <ul class="navbar__mobile-list">
        {NAV_LINKS.map(link => (
          <li class="navbar__mobile-item">
            <a href={link.href} class="navbar__mobile-link">{link.label}</a>
          </li>
        ))}
        <li class="navbar__mobile-item navbar__mobile-item--dropdown">
          <button class="navbar__mobile-link navbar__mobile-link--dropdown" type="button">
            <span>Más</span>
            <svg class="navbar__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <ul class="navbar__mobile-dropdown">
            <li><a href="/#equipo" class="navbar__mobile-dropdown-link">Equipo</a></li>
            <li><a href="/#tecnologias" class="navbar__mobile-dropdown-link">Tecnologías</a></li>
            <li><a href="/casos-exito" class="navbar__mobile-dropdown-link">Casos de Éxito</a></li>
            <li><a href="/#contacto" class="navbar__mobile-dropdown-link">Contacto</a></li>
          </ul>
        </li>
        <li class="navbar__mobile-item">
          <a href="/#contacto" class="navbar__mobile-cta">Cotizar</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(10, 12, 16, 0.6);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition: background .3s var(--ease), border-color .3s var(--ease), box-shadow .3s var(--ease);
  }
  .navbar.navbar--scrolled {
    background: rgba(10, 12, 16, 0.82);
    border-bottom-color: var(--border);
    box-shadow: 0 1px 0 rgba(255,255,255,.04), 0 8px 30px -12px rgba(0,0,0,.6);
  }

  .navbar__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .navbar__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .navbar__logo {
    height: 32px;
    width: auto;
  }

  .navbar__name {
    font-family: var(--font-satoshi-variable);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-whisper-white);
    white-space: nowrap;
  }

  .navbar__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .navbar__list {
    display: flex;
    list-style: none;
    gap: 28px;
    margin: 0;
    padding: 0;
  }

  .navbar__link {
    color: var(--ink-muted);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    padding: 8px 0;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .navbar__link:hover {
    color: var(--ink);
  }

  .navbar__chevron {
    transition: transform 0.2s;
  }

  .navbar__item--dropdown {
    position: relative;
  }

  .navbar__item--dropdown:hover .navbar__dropdown {
    display: block;
  }

  .navbar__item--dropdown:hover .navbar__chevron {
    transform: rotate(180deg);
  }

  .navbar__dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 180px;
    background: var(--color-charcoal-surface);
    border: 1px solid var(--color-ash-gray);
    border-radius: 4px;
    padding: 8px 0;
    box-shadow: var(--shadow-elevated);
  }

  .navbar__dropdown-link {
    display: block;
    color: var(--color-whisper-white);
    font-size: 14px;
    padding: 10px 16px;
    transition: background 0.2s, color 0.2s;
  }

  .navbar__dropdown-link:hover {
    background: var(--color-ash-gray);
    color: var(--color-spring-green);
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .navbar__cta {
    color: #fff;
    background: var(--brand);
    border: 1px solid transparent;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: var(--radius-full);
    box-shadow: 0 1px 0 rgba(255,255,255,.25) inset, 0 8px 24px -12px rgba(var(--brand-rgb),.7);
    transition: background 0.2s var(--ease), transform 0.15s var(--ease), box-shadow .3s var(--ease);
    white-space: nowrap;
  }

  .navbar__cta:hover {
    background: var(--brand-hi);
    transform: translateY(-2px);
    box-shadow: 0 1px 0 rgba(255,255,255,.3) inset, 0 14px 32px -12px rgba(var(--brand-rgb),.8);
  }

  .navbar__cta:active {
    transform: translateY(0) scale(0.98);
  }

  .navbar__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    border-radius: 4px;
    color: var(--color-slate-text);
    cursor: pointer;
    flex-shrink: 0;
  }

  .navbar__toggle:hover {
    background: var(--color-ash-gray);
    color: var(--color-whisper-white);
  }

  .navbar__icon--close {
    display: none;
  }

  .navbar__mobile {
    display: none;
  }

  @media (max-width: 900px) {
    .navbar__nav {
      display: none;
    }

    .navbar__toggle {
      display: flex;
    }

    .navbar__cta {
      display: inline-flex;
    }

    .navbar__mobile {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #0D1017;
      border-bottom: 1px solid var(--border);
      box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.85);
      padding: 16px;
    }

    .navbar__mobile.open {
      display: block;
    }

    .navbar__mobile-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .navbar__mobile-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      color: var(--ink);
      font-family: var(--font-body);
      font-size: 16px;
      font-weight: 500;
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      background: transparent;
      border: none;
      text-align: left;
      transition: background 0.2s;
    }

    .navbar__mobile-link:hover {
      background: var(--color-ash-gray);
    }

    .navbar__mobile-item--dropdown > .navbar__mobile-link--dropdown {
      justify-content: flex-start;
      gap: 8px;
    }

    .navbar__mobile-dropdown {
      display: none;
      list-style: none;
      margin: 0;
      padding: 0 0 0 24px;
    }

    .navbar__mobile-item--dropdown.open > .navbar__mobile-dropdown {
      display: block;
    }

    .navbar__mobile-item--dropdown.open > .navbar__mobile-link--dropdown .navbar__chevron {
      transform: rotate(180deg);
    }

    .navbar__mobile-dropdown-link {
      display: block;
      color: var(--color-slate-text);
      font-size: 14px;
      padding: 10px 16px;
      border-radius: 4px;
    }

    .navbar__mobile-dropdown-link:hover {
      background: var(--color-ash-gray);
      color: var(--color-whisper-white);
    }

    .navbar__mobile-cta {
      display: block;
      text-align: center;
      color: #fff;
      background: var(--brand);
      font-size: 16px;
      font-weight: 600;
      padding: 14px;
      border-radius: var(--radius-full);
      margin-top: 8px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('navbar-toggle');
  const menu = document.getElementById('navbar-menu');
  const dropdowns = document.querySelectorAll('.navbar__mobile-item--dropdown');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('open');
      const isOpen = menu.classList.contains('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    });
  }

  dropdowns.forEach(dropdown => {
    const btn = dropdown.querySelector('.navbar__mobile-link--dropdown');
    if (btn) {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        dropdown.classList.toggle('open');
      });
    }
  });
</script>